rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Client portal uploads. A signed-in client may read and write ONLY the
    // files under their own UID namespace (artwork, payment proofs, message
    // attachments, documents). Team uploads happen via the Admin SDK or the
    // Firebase console, which bypass these rules.
    match /portal/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Cap individual uploads at 25 MB.
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024;
    }

    // Default deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

# Local development environment variables.
# Copy to `.env.local` and fill in for local Firestore writes via Admin SDK.

# Firebase project to point at — already set to mfx-2026 via .firebaserc but
# the Admin SDK also reads this.
FIREBASE_PROJECT_ID=mfx-2026

# Option A (preferred locally): leave this blank and run
#   gcloud auth application-default login
# The Admin SDK will pick up ADC automatically.

# Option B: paste a service-account JSON (single line, escaped) here for CI or
# environments without gcloud. Generate one in the Firebase Console under
# Project settings → Service accounts → Generate new private key.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"mfx-2026", ...}

# ---------------------------------------------------------------------------
# Firebase WEB (client) SDK config — public identifiers, safe to expose.
# Required for the client portal sign-in (Google + email magic link) and
# Storage uploads. Find these in Firebase Console → Project settings →
# Your apps → SDK setup and configuration.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mfx-2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mfx-2026
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloud Storage bucket — enables portal file uploads (documents, payment
# proofs, message attachments). Without it, uploads degrade gracefully and the
# rest of the portal still works. Usually <project>.appspot.com or
# <project>.firebasestorage.app — confirm in Console → Storage.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mfx-2026.firebasestorage.app
